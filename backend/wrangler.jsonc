{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "notebookzen-backend",
  "main": "src/worker.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Keep Worker warm — free plan 10ms CPU limit is insufficient for cold-start
  // module loading. A ping every 2 minutes keeps the module scope in memory so
  // most user requests hit a warm Worker.
  "routes": [
    {
      "pattern": "notebookzen-backend.pantorn.site/*",
      "zone_name": "pantorn.site"
    }
  ],
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },
  // Non-secret env vars (safe to commit)
  // Workers AI — used for note embeddings (bge-base-en-v1.5, 768 dims)
  // Free tier, no API key needed. Used for vector similarity search in chat.
  "ai": {
    "binding": "AI"
  },
  // Worker secrets — deploy FAILS if any are missing.
  // Set values via `wrangler secret put <KEY>` (NEVER in this file, NEVER in Terraform).
  // Wrangler preserves secrets across deploys — they won't be wiped.
  "secrets": {
    "required": [
      "CLERK_SECRET_KEY",
      "CLERK_WEBHOOK_SECRET",
      "DATABASE_URL",
      "FRONTEND_URL"
    ]
  }
}
