# These values are for local development with `wrangler dev`.
# In production, secrets are set via `wrangler secret put` (NEVER Terraform).
#   wrangler secret put CLERK_SECRET_KEY
#   wrangler secret put CLERK_WEBHOOK_SECRET

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

FRONTEND_URL=http://localhost:3000
CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx

# AI settings are now per-user (BYOK) — configured via the Settings page.
# No need to set AI_PROVIDER, OPENROUTER_*, or GOOGLE_* env vars.
